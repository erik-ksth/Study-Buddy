# Recommended: a public hosted-form endpoint (for example, Formspree).
# When present, Study Buddy renders its own fully styled native form.
VITE_FEEDBACK_FORM_ENDPOINT=
VITE_SURVEY_FORM_ENDPOINT=

# Optional legacy fallback: embedded Tally forms are used only when the
# corresponding hosted-form endpoint above is absent.
# Public Tally form ID from a URL such as https://tally.so/r/FORM_ID
VITE_TALLY_FORM_ID=

# Public Tally survey ID. Successful submissions suppress the first-visit survey.
VITE_TALLY_SURVEY_FORM_ID=
