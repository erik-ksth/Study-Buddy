# Public hosted-form endpoints (for example, Formspree).
# Study Buddy renders the native themed forms and posts directly to these URLs.
VITE_FEEDBACK_FORM_ENDPOINT=
VITE_SURVEY_FORM_ENDPOINT=
VITE_POST_SESSION_FORM_ENDPOINT=

# Supabase browser-safe project credentials. Never expose a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
